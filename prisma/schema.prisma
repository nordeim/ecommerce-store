// LUXE Store — Prisma schema (SQLite)
// Money is stored as INTEGER CENTS everywhere (see src/lib/money.ts).
// SQLite has no native enums — status/role fields are Strings validated by
// Zod schemas at the application boundary (src/lib/validation.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  name         String
  firstName    String?
  lastName     String?
  phone        String?
  role         String    @default("user") // "user" | "admin" (validated in code)
  // Email verification (session-4, AUTH-VERIFY-1 — reference parity
  // machinery, env-gated: AUTH_REQUIRE_EMAIL_VERIFICATION).
  emailVerified          Boolean   @default(false)
  verificationHash       String? // scrypt hash of the 6-digit code
  verificationExpiresAt  DateTime?
  verificationAttempts   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  resetTokens  PasswordResetToken[]
  addresses    Address[]
  orders       Order[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Session-20 (RESET-ROUTE-1): single-use password-reset tokens. The link
// carries ONLY the token, so the lookup is keyed by the token's scrypt
// hash (the verification-code pattern — plaintext tokens never touch the
// DB). One row per issued link; consumed rows are deleted on success.
model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  icon      String // lucide icon component name rendered by the storefront
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  description    String
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id])
  price          Int // cents
  compareAtPrice Int? // cents; non-null drives the "-N%" badge
  rating         Float           @default(0)
  reviewCount    Int             @default(0)
  badge          String? // "Best Seller" | "Top Rated" | "Popular" | ...
  image          String
  features       String          @default("[]") // JSON-encoded string[]
  stock          Int             @default(25)
  isTrending     Boolean         @default(false)
  isNewArrival   Boolean         @default(false)
  isOnSale       Boolean         @default(false)
  isActive       Boolean         @default(true)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]
}

model Cart {
  id        String     @id @default(cuid())
  token     String     @unique
  userId    String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([cartId, productId])
}

model Wishlist {
  id        String         @id @default(cuid())
  token     String         @unique
  userId    String?        @unique
  createdAt DateTime       @default(now())
  items     WishlistItem[]
}

model WishlistItem {
  id         String    @id @default(cuid())
  wishlistId String
  wishlist   Wishlist  @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@unique([wishlistId, productId])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String  @default("Home")
  fullName  String
  street    String
  city      String
  state     String
  zip       String
  country   String  @default("United States")
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
}

model Order {
  id              String       @id @default(cuid())
  number          String       @unique // ORD-YYYY-NNNNNN
  userId          String?
  user            User?        @relation(fields: [userId], references: [id])
  email           String
  status          String       @default("processing") // processing | in_transit | delivered | cancelled
  subtotal        Int // cents
  shipping        Int          @default(0)
  total           Int // cents
  shippingAddress String // JSON snapshot of the checkout address
  paymentMethod   String       @default("card") // card | paypal
  cardLast4       String?
  // Stripe payment (session-22, PAY-STRIPE-1 — the superset checkout).
  // stripePaymentIntentId is UNIQUE: the placement idempotency anchor (the
  //   action path and the webhook backstop can never double-place an order
  //   for the same PaymentIntent — the unique violation maps to the
  //   already-placed order number).
  // paymentStatus: null = the reference-parity demo path (no charge);
  //   "paid" = a captured Stripe PaymentIntent; "failed" = recorded
  //   payment_intent.payment_failed. String, not enum (the SQLite contract).
  stripePaymentIntentId String? @unique
  paymentStatus          String?
  // Session-36 (ORDER-TRACKING-1, ADR-044): the "where's my order"
  // affordance's resting state — the carrier + tracking number the
  // operator records (setOrderTrackingAction) and both detail surfaces
  // read. Nullable = not set = the calm state (the paymentStatus
  // precedent: additive columns, zero data motion, null renders nothing).
  // Rendered from the row (like cardLast4), NEVER derived from events;
  // the tracking_added OrderEvent is the audit trail, not the source.
  carrier         String?
  trackingNumber  String?
  placedAt        DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  items           OrderItem[]
  events          OrderEvent[]
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id])
  nameSnapshot  String
  imageSnapshot String
  unitPrice     Int // cents at purchase time
  quantity      Int
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // "placed" | "status_changed" | "payment_succeeded" | "payment_failed"
  note      String?
  createdAt DateTime @default(now())
}

// Stripe webhook dedup (session-22, PAY-STRIPE-1 — the C8 lesson from the
// reference skill: the event row is the idempotency anchor; a Stripe retry
// of an already-processed event short-circuits to a 200 no-op instead of
// double-processing). eventId is Stripe's evt_* id, UNIQUE.
model StripeEvent {
  id              String   @id @default(cuid())
  eventId         String   @unique
  type            String
  paymentIntentId String?
  // session-25, PAY-OPS-2b: the event's money magnitude in integer minor
  // units (the captured amount for succeeded, the attempted amount for
  // payment_failed, the refunded amount for charge.refunded) — null for
  // payload shapes that carry none and for rows recorded before
  // session-25. The payments surface renders it beside the outcome (the
  // operator's "how much needs refunding?").
  amount Int?
  // session-30, REASON-TRAIL-1 (ADR-038): the canonical deterministic-
  // failure code the webhook persists at its four permanent-classification
  // write sites (metadata-unusable / cart-unavailable / amount-mismatch /
  // stock-short — the vocabulary exported from src/lib/stripe-payment.ts).
  // Null = no reason known: pre-session-30 rows, the failed/ignored
  // recordings, the client-path-precedence recording, and the SUCCESSFUL
  // in-tx insert (a placed order has no placement failure). The payments
  // surface renders the mapped operator copy beside the refund-needed
  // outcome (the operator's "why?"). NEVER a derivation input — the
  // refund-needed family derives from DB state (type + no linked order),
  // this column is enrichment.
  failureReason String?
  receivedAt      DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
